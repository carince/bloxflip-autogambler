{
    "compilerOptions": {
        "strict": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "baseUrl": "./src",
        "module": "NodeNext",
        "target": "ESNext",
        "moduleResolution": "NodeNext",
        "newLine": "LF",
        "inlineSourceMap": true,
        "esModuleInterop": true,
        "paths": {
            "@utils/*": [
                "backend/utils/*"
            ],
            "@server/*": [
                "backend/server/*"
            ],
            "@bf/*": [
                "backend/bloxflip/*"
            ],
            "@types": [
                "backend/utils/types.ts"
            ]
        }
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "build.mjs",
        "tsconfig.json"
    ],
    "exclude": [
        "/.github",
        "./dist",
        "./node_modules"
    ]
}